# Phase 2 — §7.1 패치 전후 비교.
#
# 비교가 성립하려면 세 가지가 같아야 한다:
#   1. 테이블 (Phase 1 이 만든 warehouse-p1 을 그대로 쓴다 — 재생성하지 않는다)
#   2. 스캔 워크로드 (../phase0/spark/scan.py, 같은 SCAN_ITERS/SCAN_COLS)
#   3. 반복 횟수 (REPS=3 — 노이즈 바닥 9.7%, F-010)
# 다른 것은 오직 jar 하나뿐이다.

P2_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# phase0/config.env 의 jar 탐색은 "${DV_JAR_DIR}/${ICEBERG_JAR_NAME}" 을 첫 후보로 본다.
# 그래서 source 하기 '전에' 패치 jar 디렉터리를 심어야 한다.
export DV_JAR_DIR="${DV_JAR_DIR:-$HOME/opt/jars-patched}"

# phase1 -> phase0 순으로 체인된다. WAREHOUSE 는 phase1 의 warehouse-p1 이 되고,
# 그게 정확히 우리가 원하는 값이다 (같은 테이블을 다시 잰다).
source "${P2_ROOT}/../phase1/config.env"

PROJECT_ROOT="$P2_ROOT"
RESULTS="${P2_ROOT}/results"

# 베이스라인 jar (패치 전). 비교 대상.
#
# ⚠️ Maven 에서 받은 릴리스 jar 을 쓰지 않는다. 같은 소스 트리(apache-iceberg-1.11.0 태그)를
#    패치만 stash 한 상태로 다시 빌드해서 쓴다. 릴리스 jar 과 비교하면 빌드 환경
#    (JDK 패치 레벨, 셰이딩 순서, 의존성 해석)의 차이가 패치 효과로 둔갑할 수 있다.
#    두 jar 의 유일한 차이가 우리 diff 여야 한다.
BASELINE_JAR="${BASELINE_JAR:-$HOME/opt/jars-baseline/${ICEBERG_JAR_NAME}}"
PATCHED_JAR="${PATCHED_JAR:-${DV_JAR_DIR}/${ICEBERG_JAR_NAME}}"

# 위 source 가 고른 jar 이 정말 패치본인지 확인한다.
# 조용히 베이스라인으로 폴백하면 "개선 없음" 이라는 가짜 결론이 나온다.
if [[ "${ICEBERG_JAR:-}" != "$PATCHED_JAR" ]]; then
  echo "  [config] ⚠️  패치 jar 을 못 찾았습니다." >&2
  echo "           기대: $PATCHED_JAR" >&2
  echo "           실제: ${ICEBERG_JAR:-<--packages 폴백>}" >&2
  echo "           scripts/00-install-jar.sh 를 먼저 실행하세요." >&2
fi

# 베이스라인 결과는 phase1 에서 이미 잰 것을 재사용하지 않는다.
# 이유: jar 이 바뀌면 클래스 로딩/JIT 프로파일도 바뀌므로, 같은 세션 안에서
#       두 jar 을 번갈아 재야 공정하다. 그래서 베이스라인도 여기서 다시 잰다.
: "${CLUSTER_DENSITY_BP:=50}"
: "${RUN_LENGTHS:=1 4096}"

# 밀도 축은 이야기가 걸린 두 점 + 극단만.
#   610 = 최악(array, 경계 직전),  700 = 최선(bitmap),  50 = 실무 CDC 대표값
P2_DENSITIES_BP="${P2_DENSITIES_BP:-50 610 700}"

REPS="${REPS:-3}"
SCAN_ITERS="${SCAN_ITERS:-30}"
SCAN_COLS="${SCAN_COLS:-1}"
