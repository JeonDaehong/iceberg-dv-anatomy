{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DvAnatomyBucketOnly",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::dv-anatomy-394686422456-apne2"
    },
    {
      "Sid": "DvAnatomyObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::dv-anatomy-394686422456-apne2/*"
    }
  ]
}
