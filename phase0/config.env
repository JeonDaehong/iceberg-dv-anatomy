# Phase 0 설정 — 모든 스크립트가 이 파일을 source 합니다.
# 값을 바꾸면 results/ 를 비우고 다시 돌리세요 (섞이면 해석 불가).

# ---------- 버전 ----------
SPARK_MAJOR="4.0"
SCALA_BIN="2.13"
ICEBERG_VERSION="1.11.0"
ICEBERG_PKG="org.apache.iceberg:iceberg-spark-runtime-${SPARK_MAJOR}_${SCALA_BIN}:${ICEBERG_VERSION}"
ICEBERG_JAR_NAME="iceberg-spark-runtime-${SPARK_MAJOR}_${SCALA_BIN}-${ICEBERG_VERSION}.jar"

# Spark 3.5를 쓴다면:
#   SPARK_MAJOR="3.5"; SCALA_BIN="2.12"

# 로컬 fat jar 이 있으면 --jars 로, 없으면 --packages 로 폴백한다.
#
# --jars 를 쓰는 이유는 오프라인 실행뿐이 아니다. --packages 는 매 spark-submit 마다
# Ivy 해석을 '프로파일링 대상 JVM 안에서' 수행하므로, 그 시간이 통째로 분모에 섞여
# DV 비중을 왜곡한다. 로컬 jar 을 쓰면 그 노이즈가 사라진다.
ICEBERG_JAR_CANDIDATES=(
  "${DV_JAR_DIR:-}/${ICEBERG_JAR_NAME}"
  "$HOME/opt/jars/${ICEBERG_JAR_NAME}"
  "/mnt/d/dv-tools/dl/${ICEBERG_JAR_NAME}"
  "D:/dv-tools/dl/${ICEBERG_JAR_NAME}"
)
SPARK_ICEBERG_ARGS=(--packages "${ICEBERG_PKG}")
for _c in "${ICEBERG_JAR_CANDIDATES[@]}"; do
  if [[ -n "$_c" && -f "$_c" ]]; then
    SPARK_ICEBERG_ARGS=(--jars "$_c")
    ICEBERG_JAR="$_c"
    break
  fi
done
unset _c

# ---------- 경로 ----------
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RESULTS="${PROJECT_ROOT}/results"

# ⚠️ WSL2 에서 /mnt/* (Windows 드라이브)는 9p 프로토콜을 타서 I/O 가 수십 배 느리다.
# 워크로드 데이터를 거기 두면 Parquet 읽기가 프로파일 전체를 잡아먹어
# "DV 체크 비중"이 인위적으로 0 에 수렴한다 = 게이트가 STOP 으로 오판한다.
# 따라서 프로젝트가 /mnt 아래 있으면 warehouse 는 Linux 네이티브 fs 로 강제한다.
if [[ -n "${DV_WAREHOUSE:-}" ]]; then
  WAREHOUSE="$DV_WAREHOUSE"
elif [[ "$PROJECT_ROOT" == /mnt/* ]]; then
  WAREHOUSE="$HOME/dv-anatomy/warehouse"
  echo "  [config] 프로젝트가 /mnt 아래 있어 warehouse 를 Linux fs 로 돌립니다: $WAREHOUSE" >&2
else
  WAREHOUSE="${PROJECT_ROOT}/warehouse"
fi
# 도구 위치는 환경변수에 의존하지 않고 직접 탐지한다.
# 이유: Ubuntu 의 ~/.bashrc 는 비대화형 셸에서 맨 앞에 return 해버려서
#       `wsl -- bash -lc ...` 로 실행하면 export 가 전혀 반영되지 않는다.
#       스크립트가 스스로 찾게 만들어야 호출 방식에 무관하게 동작한다.
_probe() { local d; for d in "$@"; do [[ -n "$d" && -d "$d" ]] && { printf '%s' "$d"; return 0; }; done; return 1; }

AP_HOME="${AP_HOME:-$(_probe "$HOME/opt/async-profiler-4.5-linux-x64" \
                              "$HOME/async-profiler-4.5-linux-x64" \
                              "/opt/async-profiler-4.5-linux-x64")}"
AP_LIB="${AP_HOME}/lib/libasyncProfiler.so"

SPARK_HOME="${SPARK_HOME:-$(_probe "$HOME/opt/spark-4.0.4-bin-hadoop3" \
                                    "$HOME/spark-4.0.4-bin-hadoop3" \
                                    "/opt/spark-4.0.4-bin-hadoop3")}"
if [[ -n "${SPARK_HOME:-}" && -d "$SPARK_HOME/bin" ]]; then
  case ":$PATH:" in *":$SPARK_HOME/bin:"*) ;; *) export PATH="$SPARK_HOME/bin:$PATH" ;; esac
fi

JAVA_HOME="${JAVA_HOME:-$(_probe /usr/lib/jvm/java-17-openjdk-amd64)}"
if [[ -n "${JAVA_HOME:-}" && -d "$JAVA_HOME/bin" ]]; then
  export JAVA_HOME
  case ":$PATH:" in *":$JAVA_HOME/bin:"*) ;; *) export PATH="$JAVA_HOME/bin:$PATH" ;; esac
fi

# ---------- 데이터 규모 ----------
# 청크 수 = ROWS_PER_FILE / 65536.  2,000,000 -> 30.5 청크/파일
ROWS_PER_FILE="${ROWS_PER_FILE:-2000000}"
NUM_FILES="${NUM_FILES:-4}"
SEED=20260817

# ---------- Spark 리소스 ----------
DRIVER_MEM="8g"
LOCAL_CORES="4"          # 결정론을 위해 고정. '*' 쓰지 말 것.

# ---------- 프로파일링 ----------
# WSL2/가상화 환경: ctimer (perf_events 불필요)
# .metal 환경   : cpu    (하드웨어 PMU)
AP_EVENT="${AP_EVENT:-ctimer}"

# ---------- 스캔 워크로드 ----------
# 전부 ${VAR:-기본값} 이다. 하드코딩하면 상위 phase 가 이 파일을 source 한 뒤
# 환경변수가 덮어써져, `WIDE_COLS=3 06-widescan.sh` 같은 호출이 조용히 무시된다.
# 2026-08-30 에 REPS 로, 08-31 에 WIDE_COLS 로 같은 함정을 두 번 밟았다.
# WIDE_COLS 쪽은 더 고약했다 — 20컬럼 프로파일이 이미 있어서 전부 skip 으로 끝나
# "0초 만에 성공" 처럼 보였다.
SCAN_WARMUP="${SCAN_WARMUP:-3}"
SCAN_ITERS="${SCAN_ITERS:-12}"
# 좁은 스캔 / 넓은 스캔 — DV 비중은 컬럼 수에 반비례하므로 양끝을 잰다
NARROW_COLS="${NARROW_COLS:-1}"
WIDE_COLS="${WIDE_COLS:-20}"

# ---------- 삭제 패턴 (Phase 0은 양 극단 + 대조군만) ----------
# none   : DV 없음 (대조군 — 분류기 오탐 검증용)
# sparse : d=0.5%, C=1   -> array 컨테이너
# run    : 연속 30% 블록  -> run 컨테이너
PATTERNS="none sparse run"
SPARSE_DENOM=200         # 1/200 = 0.5%
RUN_START_FRAC=0.35
RUN_END_FRAC=0.65
