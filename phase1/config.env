# Phase 1 — (d, C, p) 격자. 이번 단계의 주축은 밀도 d 스윕이다.
#
# 핵심 질문:
#   F-001 의 "6.25% 경계에서 행당 비용 4.1배 점프" 는 단일 청크를 통제한
#   마이크로벤치에서 나왔다. 실제 테이블은 파일당 청크가 30개이고 청크마다
#   밀도가 흔들리므로, 경계 부근에서 array 와 bitmap 이 '섞인다'.
#   그래도 계단이 보이는가, 아니면 뭉개져서 완만한 경사가 되는가?

P1_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# phase0 의 도구 탐지 로직을 그대로 재사용한다 (WSL /mnt 함정 + jar 탐색 포함).
# 주의: phase0/config.env 는 PROJECT_ROOT / RESULTS / WAREHOUSE 를 자기 기준으로
# 덮어쓴다. 그래서 source 는 먼저 하고, Phase 1 값은 그 뒤에 다시 지정한다.
source "${P1_ROOT}/../phase0/config.env"

PROJECT_ROOT="$P1_ROOT"
RESULTS="${P1_ROOT}/results"
WAREHOUSE="$(dirname "${WAREHOUSE}")/warehouse-p1"

# ---------- 격자: 밀도 d ----------
# 단위는 basis point of 10000 (예: 625 = 6.25%).
# 삭제 술어: pmod(hash(id, SEED), 10000) < D
#
# 경계(625) 주변을 촘촘히 잡은 이유:
#   청크당 카디널리티 ~ Binomial(65536, d)
#   d=6.25% 에서 평균 4096, 표준편차 sqrt(65536*0.0625*0.9375) ≈ 62
#   -> 4096 임계값이 정확히 평균에 걸린다. 청크의 약 절반이 array, 절반이 bitmap.
#   -> 전이 구간은 대략 d ∈ [5.9%, 6.6%] 로 매우 좁다 (±2σ ≈ ±0.19%p).
# 이 예측이 틀리면 격자 설계 자체를 다시 봐야 하므로 반증 가능하게 배치했다.
DENSITIES_BP="0 5 50 300 500 550 590 610 625 640 660 700 800 1200 5000"

# 비용 프로파일링은 비싸므로 부분집합만 (경계 양쪽 + 극단)
PROFILE_DENSITIES_BP="0 50 500 610 625 640 700 1200 5000"

# ---------- 데이터 규모 ----------
# 청크 통계의 표본 수 = NUM_FILES * (ROWS_PER_FILE / 65536)
# 4 * 30.5 = 122 청크. 혼합 비율을 재기에 충분하다.
ROWS_PER_FILE=2000000
NUM_FILES=4
SEED=20260817

# ---------- 스캔 ----------
# 밀도가 달라도 contains() 호출 횟수는 동일하다 (배치마다 batchSize 번, 항상).
# 따라서 총 스캔 행 수를 고정하면 DV 샘플 수가 곧 '호출당 비용'의 직접 지표가 된다.
# 컬럼 폭은 DV 비중이 가장 크게 보이는 narrow 만 사용한다.
SCAN_COLS=1
SCAN_WARMUP=3
# 8 -> 30. 프로파일 1회 40초 중 ~30초가 JVM/Spark 기동이라
# 스캔 반복을 늘려도 벽시계 비용은 거의 안 늘고 샘플만 늘어난다.
SCAN_ITERS=30

# 반복 측정 횟수. 2026-08-17 에 같은 설정을 두 번 재서 303 vs 363 (20% 차이),
# 또 다른 쌍은 120 vs 169 (41% 차이) 가 나왔다. JIT 타이밍/GC/샘플러 위상 때문이다.
# √n 노이즈 추정(±6%)은 완전히 과소평가였다. 반복 없이는 2배 미만 차이를 주장할 수 없다.
# ${REPS:-3} 인 이유: 하드코딩하면 phase2 가 이 파일을 source 한 뒤
# 환경변수 REPS 가 덮어써져, `REPS=6 06-widescan.sh` 같은 호출이
# 조용히 무시되고 0초 만에 전부 skip 으로 끝난다 (2026-08-30 에 실제로 겪음).
REPS="${REPS:-3}"
